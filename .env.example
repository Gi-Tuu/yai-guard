# 复制为 .env 并填值；.env 已被 .gitignore 忽略，绝不入库。
# 控制面（yai-app）
DOMAIN=203-0-113-10.sslip.io
ACME_EMAIL=you@example.com
VULTR_INFERENCE_API_KEY=
MODEL_PRIMARY=deepseek-v4.1-flash-1017
MOCK_MODEL=0

# 公网 Demo 保护（P1-2）：生产必须设置；本地开发用 ALLOW_ANONYMOUS=1 显式放行
DEMO_TOKEN=
DEMO_TOKENS=
ALLOW_ANONYMOUS=0
RATE_LIMIT_PER_MIN=10

# 执行面（yai-sandbox），与 app 共享同一个 token
SANDBOX_DRIVER=remote
SANDBOX_BASE_URL=http://10.99.0.20:9000
SANDBOX_TOKEN=
SANDBOX_RUNTIME=runc
SANDBOX_IMAGE=yaiguard/sandbox-py:1.0
SANDBOX_PRIVATE_IP=10.99.0.20
# 宿主机 /var/run/docker.sock 的组 ID：stat -c '%g' /var/run/docker.sock
# Docker Desktop 通常为 0；Vultr Ubuntu 通常为 docker 组 GID（如 998/999）
DOCKER_GID=0

