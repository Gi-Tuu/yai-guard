[Unit]
Description=YAI Guard API
After=network.target
Requires=network-online.target

[Service]
Type=simple
User=yaiguard
Group=yaiguard
WorkingDirectory=/opt/yai-guard/backend
EnvironmentFile=/opt/yai-guard/.env.app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/yai-guard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yai-guard/artifacts
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
